    "@fontsource/hanken-grotesk": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@fontsource/schibsted-grotesk": "^5.3.0",
    "@tiptap/core": "^3.33.0",
    "@tiptap/extension-image": "^3.33.0",
    "@tiptap/extension-table": "^3.33.0",
    "@tiptap/extensions": "^3.33.0",
    "@tiptap/pm": "^3.33.0",
    "@tiptap/react": "^3.33.0",
    "@tiptap/starter-kit": "^3.33.0",
    "better-auth": "^1.7.18",
    "drizzle-orm": "^0.45.4",
    "next": "16.4.5",
    "pg": "^8.23.1",
    "react": "19.3.0",
