# Copy to .env for local development. Never commit .env.

# Postgres. Locally any Postgres works; in production use Supabase's
# *direct* connection string here (for migrations and seeding). The live site
# connects through Cloudflare Hyperdrive instead (see docs/DEPLOYMENT.md).
DATABASE_URL=postgres://postgres:localdev@localhost:5432/pornmag
TEST_DATABASE_URL=postgres://postgres:localdev@localhost:5432/pornmag_test

# Which publication localhost / *.workers.dev show.
DEFAULT_PUBLICATION_SLUG=main

# Auth. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Email (password resets). Without a key, emails are printed to the dev log;
# production refuses to start auth email without it.
RESEND_API_KEY=
EMAIL_FROM="Magazine <hello@yourdomain.com>"

# Media. Public URL of the R2 media bucket (or its custom domain).
# Defaults to /media (files in public/media) for development.
NEXT_PUBLIC_MEDIA_BASE_URL=
# Set to "cloudflare" once Image Transformations is enabled on the zone.
NEXT_PUBLIC_IMAGE_TRANSFORMS=

# Seeding (optional)
SEED_PUBLICATION_NAME=Working Title
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_DOMAIN=
